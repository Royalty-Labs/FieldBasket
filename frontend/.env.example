# Copy to frontend/.env.local for development, or set in your hosting dashboard.
# The public URL of the FieldBasket API (no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8001

# Where FieldBasket operates, as shown on the website (default: Ekiti State)
VITE_SERVICE_AREA=Ekiti State

# Public contact email shown in the footer (hidden when empty)
VITE_CONTACT_EMAIL=
