# Copy to backend/.env and fill in. Never commit the real .env.

# PostgreSQL in production, e.g. postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./farmlink.db

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Comma-separated frontend URLs allowed to call the API (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Product photo storage (https://cloudinary.com). Leave blank to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The public website address (used in emails and payment return links).
# Optional: defaults to the first address in CORS_ORIGINS.
FRONTEND_URL=

# "development" on your own computer; leave "production" on Render
ENVIRONMENT=development

# Error alerts from https://sentry.io (optional)
SENTRY_DSN=

# ── Email ──────────────────────────────────────────────────────────────
# Any SMTP service works (Brevo, Zoho, Mailgun, Gmail app password...).
# Leave SMTP_HOST blank and emails are skipped (logged only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM="FieldBasket <orders@example.com>"

# ── Payments ───────────────────────────────────────────────────────────
# Each option shows at checkout only once its keys are set.
# Paystack: Settings → API Keys & Webhooks. Webhook URL to set there:
#   https://YOUR-API/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
# Interswitch Web Checkout (Quickteller Business): merchant code + pay item id
INTERSWITCH_MERCHANT_CODE=
INTERSWITCH_PAY_ITEM_ID=
INTERSWITCH_MODE=test

# Minutes before an unpaid basket gives its stock back
CHECKOUT_EXPIRY_MINUTES=60
